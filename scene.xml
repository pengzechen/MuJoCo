<mujoco model="four_wheel_arm_robot">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4" iterations="80"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.35 0.35 0.35" specular="0.2 0.2 0.2"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture name="floor_texture" type="2d" builtin="checker" width="512" height="512" rgb1="0.16 0.20 0.25" rgb2="0.10 0.13 0.17"/>
    <material name="floor_material" texture="floor_texture" texrepeat="12 12" reflectance="0.15"/>
  </asset>

  <default>
    <joint damping="0.25" armature="0.01"/>
    <geom contype="1" conaffinity="1" friction="0.8 0.02 0.01" solref="0.01 1" solimp="0.9 0.95 0.01"/>
    <motor ctrllimited="true" ctrlrange="-12 12"/>
  </default>

  <worldbody>
    <light name="key" pos="2 -3 5" dir="-0.2 0.3 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="10 10 0.1" material="floor_material" friction="1.2 0.1 0.01"/>
    <geom name="front_wall" type="box" pos="-4.0 0 0.25" size="0.06 4.0 0.25" rgba="0.45 0.48 0.52 1"/>
    <geom name="rear_wall" type="box" pos="4.0 0 0.25" size="0.06 4.0 0.25" rgba="0.45 0.48 0.52 1"/>
    <geom name="left_wall" type="box" pos="0 4.0 0.25" size="4.0 0.06 0.25" rgba="0.45 0.48 0.52 1"/>
    <geom name="right_wall" type="box" pos="0 -4.0 0.25" size="4.0 0.06 0.25" rgba="0.45 0.48 0.52 1"/>

    <body name="robot" pos="0 0 0.44">
      <freejoint name="robot_free"/>
      <geom name="chassis" type="box" size="0.62 0.42 0.16" rgba="0.08 0.25 0.62 1" mass="8"/>
      <geom name="top_plate" type="box" pos="0 0 0.2" size="0.48 0.32 0.04" rgba="0.12 0.42 0.85 1" mass="1"/>

      <body name="front_left_wheel" pos="-0.43 0.46 -0.2" quat="0.7071 0.7071 0 0">
        <joint name="front_left_wheel_joint" type="hinge" axis="0 0 1"/>
        <geom name="front_left_wheel_geom" type="cylinder" size="0.18 0.09" rgba="0.04 0.04 0.05 1" mass="0.5" friction="0.45 0.01 0.01"/>
      </body>
      <body name="front_right_wheel" pos="-0.43 -0.46 -0.2" quat="0.7071 0.7071 0 0">
        <joint name="front_right_wheel_joint" type="hinge" axis="0 0 1"/>
        <geom name="front_right_wheel_geom" type="cylinder" size="0.18 0.09" rgba="0.04 0.04 0.05 1" mass="0.5" friction="0.45 0.01 0.01"/>
      </body>
      <body name="rear_caster" pos="0.48 0 -0.20">
        <joint name="caster_swivel" type="hinge" axis="0 0 1" damping="0.02"/>
        <geom name="caster_fork" type="box" pos="0 0 0.08" size="0.045 0.045 0.08" rgba="0.25 0.28 0.32 1" mass="0.03" contype="0" conaffinity="0"/>
        <body name="caster_wheel" pos="0 0 -0.08" quat="0.7071 0.7071 0 0">
          <joint name="caster_roll" type="hinge" axis="0 0 1" damping="0.01"/>
          <geom name="caster_wheel_geom" type="cylinder" size="0.09 0.04" rgba="0.06 0.06 0.07 1" mass="0.12" friction="0.04 0.001 0.001"/>
        </body>
      </body>

      <body name="shoulder_yaw" pos="0 0 0.24">
        <joint name="shoulder_joint" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
        <geom name="shoulder_motor" type="cylinder" size="0.13 0.1" rgba="0.95 0.55 0.08 1" mass="0.7"/>
        <body name="upper_arm" pos="0.0 0 0.25">
          <geom name="upper_arm_link" type="capsule" fromto="0 0 -0.25 0 0 0.25" size="0.09" rgba="0.95 0.62 0.12 1" mass="0.35"/>
          <body name="elbow" pos="0 0 0.50">
            <joint name="elbow_joint" type="hinge" axis="0 1 0" range="-2.4 0.4"/>
            <geom name="elbow_motor" type="sphere" size="0.11" rgba="0.85 0.35 0.04 1" mass="0.45"/>
            <body name="forearm" pos="0 0 0.22">
              <geom name="forearm_link" type="capsule" fromto="0 0 -0.22 0 0 0.22" size="0.075" rgba="0.96 0.72 0.20 1" mass="0.25"/>
              <body name="gripper_tip" pos="0 0 0.45">
                <geom name="gripper_palm" type="box" size="0.12 0.12 0.055" rgba="0.95 0.25 0.12 1" mass="0.25"/>
                <body name="left_finger" pos="0 0.11 0">
                  <joint name="gripper_joint" type="slide" axis="0 1 0" range="0 0.10"/>
                  <geom name="left_finger_geom" type="box" pos="0 0.045 -0.08" size="0.035 0.045 0.12" rgba="0.95 0.25 0.12 1" mass="0.12"/>
                </body>
                <body name="right_finger" pos="0 -0.11 0">
                  <geom name="right_finger_geom" type="box" pos="0 -0.045 -0.08" size="0.035 0.045 0.12" rgba="0.95 0.25 0.12 1" mass="0.12"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="tennis_ball" pos="-0.90 0 0.12">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.12" rgba="0.76 0.96 0.08 1" mass="0.06" friction="0.9 0.03 0.01"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="front_left_drive" joint="front_left_wheel_joint" kv="2.5" ctrlrange="-8 8"/>
    <velocity name="front_right_drive" joint="front_right_wheel_joint" kv="2.5" ctrlrange="-8 8"/>
    <position name="shoulder_servo" joint="shoulder_joint" kp="350" kv="35" ctrlrange="-1.5 1.5"/>
    <position name="elbow_servo" joint="elbow_joint" kp="300" kv="30" ctrlrange="-2.4 0.4"/>
    <position name="gripper_servo" joint="gripper_joint" kp="180" kv="18" ctrlrange="0 0.10"/>
  </actuator>

  <equality>
    <weld name="ball_grasp" body1="gripper_tip" body2="tennis_ball" active="false" solref="0.01 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
